// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model Login {
  id           Int      @id @default(autoincrement())
  PhoneNumber  String?
  Password     String
  token        String?
  refreshToken String?
  created      DateTime @default(now())
  email        String?
  FirstName    String
  LastName     String
  profile      String
  startDate    DateTime?
  endDate      DateTime?
  shop         Shop[]
}

model Shop{
  id        Int      @id @default(autoincrement())
  shopName  String
  created   DateTime @default(now())
  profile   String
  subscription String
  latitude  Float @default(0.00)
  longitude Float @default(0.00)
  level     String @default("Basic")
  Phonenumber String @default("0000000000")
  location  String  @default("General")
  login     Login     @relation(fields: [loginId], references: [id])
  loginId   Int
  products  Products[]
  hasOffer  Boolean @default(false) 
  category  String @default("General")
  rating    Int @default(1)
  trial     DateTime @default(now())
  credit    Int @default(0)
}

model Notifications{
  id        Int      @id @default(autoincrement())
  message   String
  created   DateTime @default(now())
  header    String
  global    String
  userId    String
  seen      String
}

model Products{
  id        Int      @id @default(autoincrement())
  productName String
  discount    Int @default(0)
  created     DateTime @default(now())
  price       Float
  shop        Shop     @relation(fields: [shopId], references: [id])
  shopId      Int
  quantity    Int @default(0)
  size        String?
  color       String?
  description String?
  image       String?
  isTrending  Boolean @default(false) 
  isOffer     Boolean @default(false)
  reviews     Reviews[]
  category    Category?     @relation(fields: [categoryId], references: [id])
  categoryId  Int?
  order    Order?     @relation(fields: [orderId], references: [id])  
  orderId  Int?
  isProduct  Boolean @default(true)
  condition String @default("New")
  views     Int @default(0)
  sold      Int @default(0)
  images    String[]
}

model Reviews{
  id        Int      @id @default(autoincrement())
  review    String
  created   DateTime @default(now())
  rating    Int
  username  String?
  userId    Int
  reviews   Products     @relation(fields: [reviewId], references: [id])
  reviewId    Int
}

model Category{
  id        Int      @id @default(autoincrement())
  name      String
  logo      String
  products  Products[]
}

model Order{

  id Int @id @default(autoincrement())
  Name String
  PhoneNumber String
  email String
  created DateTime @default(now())
  isDelivered Boolean @default(false)
  isPaid Boolean @default(false)
  isCancelled Boolean @default(false)
  isProcessing Boolean @default(false)
  order Products[]
  orderHash  String?
}

model Banner{
  id        Int      @id @default(autoincrement())
  image     String
  created   DateTime @default(now())
  tagLine   String
  isActive  Boolean @default(false)
  color     String
  header    String?
}

model OrderDetails{
  id        Int      @id @default(autoincrement())
  prodId    Int
  orderId   Int
  productId Int
  quantity  Int
  price     Float
  created   DateTime @default(now())
  productName String
  discount    Int @default(0)
  shopId      Int
  orderHash  String?
  orderStatus Boolean @default(false)
  img        String @default("https://res.cloudinary.com/dxvzhx7zg/image/upload/v1629780134/ecommerce/placeholder.png")
} 